<header class="topbar">
  <div class="topbar-inner">
    <%= link_to "Incident Desk", root_path, class: "brand" %>
    <div class="user">
      <span><%= current_user.email_address %> · <%= current_user.role.humanize %></span>
      <%= button_to "Log out", session_path, method: :delete, class: "btn btn-plain btn-sm", form_class: "inline-form" %>
    </div>
  </div>
</header>
